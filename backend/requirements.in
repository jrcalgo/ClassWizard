# Backend image dependencies. One lock per Linux architecture (the Dockerfile
# picks one from TARGETARCH). Compile each with the CPU PyTorch index first,
# so torch stays a +cpu wheel:
#   uv pip compile backend/requirements.in --python-version 3.12 \
#     --python-platform x86_64-unknown-linux-gnu \
#     --index-url https://download.pytorch.org/whl/cpu \
#     --extra-index-url https://pypi.org/simple \
#     --index-strategy unsafe-best-match --emit-index-url \
#     -o backend/requirements.linux-64.lock
#   (same, with --python-platform aarch64-unknown-linux-gnu and
#    -o backend/requirements.linux-aarch64.lock)

torch
fastapi
uvicorn
psycopg[binary]
redis
pdfplumber>=0.10
jsonschema>=4.18
pandas
pydantic
litellm
python-multipart
# Accounts: Fernet encryption of saved audits; Google OIDC token exchange.
# (Passwords use stdlib hashlib.scrypt, so no extra hashing package.)
cryptography
httpx
sentence-transformers
pyspark==3.5.0
# pyspark 3.5 imports distutils; Python 3.12 no longer ships it, setuptools provides it.
setuptools
