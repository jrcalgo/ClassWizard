# Copy to .env (already in .gitignore) and fill in. Compose reads .env automatically.

# Postgres
POSTGRES_DB=classwizard
POSTGRES_USER=classwizard
POSTGRES_PASSWORD=change-me
# Not published to the host. Postgres is only reachable on the compose network.
POSTGRES_PORT=5432

# pgAdmin (only used with: docker compose --profile admin up -d)
PGADMIN_EMAIL=admin@classwizard.local
PGADMIN_PASSWORD=change-me
PGADMIN_PORT=5050

# catalog-pipeline
# Folder holding ..._pg1.pdf ... _pg38.pdf. Relative to this file, or absolute
# (Windows example: C:/Users/you/Documents/catalog_pdfs).
CATALOG_PDF_DIR=./data/catalog_pdfs
CATALOG_NAME=Undergraduate 2026-2027

# Chat replies. LLM_MODE is api or subscription.
# API: set LLM_MODEL, and LLM_API_BASE plus LLM_API_KEY when the endpoint needs them.
# A LiteLLM proxy is LLM_API_BASE=https://litellm.example.com/v1 and LLM_API_KEY.
# A Groq-hosted OpenAI model keeps its openai/ name and adds the groq/ provider, such as groq/openai/gpt-oss-20b.
LLM_MODE=api
LLM_SUBSCRIPTION=
LLM_MODEL=openai/gpt-4o-mini
LLM_API_BASE=
LLM_API_KEY=
# Subscription: LLM_SUBSCRIPTION is claude, chatgpt, or copilot.
# LLM_MODEL is the bare id, such as claude-sonnet-5-5 or gpt-5.
# CLAUDE_HOME and CODEX_HOME override ~/.claude and ~/.codex when those are not the login folders.
CLAUDE_HOME=
CODEX_HOME=

# /explain (cited answers). Local Ollama by default; hosted models need EXPLAIN_ALLOW_REMOTE=1.
# Ollama runs in the "ollama" container, and "ollama-pull" downloads
# EXPLAIN_MODEL on the first start (qwen3:8b is about 5 GB; give Docker
# Desktop 8 GB of memory or more). Less RAM? Use a smaller model:
#   EXPLAIN_MODEL=ollama_chat/qwen3:4b     (about 2.5 GB, 6 GB+ memory)
#   EXPLAIN_MODEL=ollama_chat/qwen3:1.7b   (about 1.4 GB, 4 GB+ memory)
EXPLAIN_MODEL=ollama_chat/qwen3:8b
# Bundled container. Already running Ollama on your machine? Set
# OLLAMA_URL=http://host.docker.internal:11434 and start with
# docker compose up -d --scale ollama=0 --scale ollama-pull=0
OLLAMA_URL=http://ollama:11434
# Seconds the backend waits for one answer. CPU-only answers can take minutes.
# Keep below 240 (the frontend's wait).
EXPLAIN_TIMEOUT=180
# Let thinking models (qwen3) reason before answering. Off: about 5x faster on
# CPU, and the reasoning is thrown away before the answer is shown anyway.
EXPLAIN_THINK=false
# Seconds an uploaded audit is kept when the page stops renewing it. Must be
# longer than EXPLAIN_TIMEOUT, or the audit can expire while an answer is written.
AUDIT_TTL_SECONDS=600
# 1 lets /explain use a hosted EXPLAIN_MODEL with LLM_API_KEY, e.g. openrouter/meta-llama/llama-3.1-70b-instruct
EXPLAIN_ALLOW_REMOTE=0

# Frontend chat panel: explain (cited, local) or chat (syllabus triples, LLM_MODEL provider)
CHAT_MODE=explain

# --- Web app and accounts ----------------------------------------------------
# Address people open in the browser. Used for cookies (Secure when https),
# email links, the Google redirect URI and the cross-site request check.
PUBLIC_BASE_URL=http://localhost:8501
# Host port for the web app (nginx). Keep it in step with PUBLIC_BASE_URL.
FRONTEND_PORT=8501
# Extra origins allowed to send requests, comma separated (the Vite dev server).
ALLOWED_ORIGINS=http://localhost:5173
# Signs the short-lived Google sign-in state. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# Encrypts DegreeWorks audits saved for signed-in users (Fernet). Empty means
# audits are never saved. Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# To rotate, put the new key first: AUDIT_ENCRYPTION_KEY=new_key,old_key
AUDIT_ENCRYPTION_KEY=

# Sign in with Google (optional; the button is disabled while these are empty).
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web).
# Authorized redirect URI: ${PUBLIC_BASE_URL}/api/auth/google/callback
#   e.g. http://localhost:8501/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email for verification and password reset. Defaults send to the bundled
# Mailpit container (inbox at http://localhost:8025). For real mail, e.g.:
#   SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_STARTTLS=1 SMTP_USER=... SMTP_PASSWORD=<app password>
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ClassWizard <no-reply@classwizard.local>
SMTP_STARTTLS=0
SMTP_SSL=0
MAILPIT_UI_PORT=8025
