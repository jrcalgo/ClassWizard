# Copy to .env (already in .gitignore) and fill in. Compose reads .env automatically.

# Postgres
POSTGRES_DB=classwizard
POSTGRES_USER=classwizard
POSTGRES_PASSWORD=change-me
# Not published to the host. Postgres is only reachable on the compose network.
POSTGRES_PORT=5432

# pgAdmin (only used with: docker compose --profile admin up -d)
PGADMIN_EMAIL=admin@classwizard.local
PGADMIN_PASSWORD=change-me
PGADMIN_PORT=5050

# catalog-pipeline
# Folder holding ..._pg1.pdf ... _pg38.pdf. Relative to this file, or absolute
# (Windows example: C:/Users/you/Documents/catalog_pdfs).
CATALOG_PDF_DIR=./data/catalog_pdfs
CATALOG_NAME=Undergraduate 2026-2027

# Chat replies. LLM_MODE is api or subscription.
# API: set LLM_MODEL, and LLM_API_BASE plus LLM_API_KEY when the endpoint needs them.
# A LiteLLM proxy is LLM_API_BASE=https://litellm.example.com/v1 and LLM_API_KEY.
# A Groq-hosted OpenAI model keeps its openai/ name and adds the groq/ provider, such as groq/openai/gpt-oss-20b.
LLM_MODE=api
LLM_SUBSCRIPTION=
LLM_MODEL=openai/gpt-4o-mini
LLM_API_BASE=
LLM_API_KEY=
# Subscription: LLM_SUBSCRIPTION is claude, chatgpt, or copilot.
# LLM_MODEL is the bare id, such as claude-sonnet-5-5 or gpt-5.
# CLAUDE_HOME and CODEX_HOME override ~/.claude and ~/.codex when those are not the login folders.
CLAUDE_HOME=
CODEX_HOME=

# /explain (cited answers). 
# Run Ollama on the host and pull the model first: ollama pull qwen3:8b
EXPLAIN_MODEL=ollama_chat/llama3.2:latest
OLLAMA_URL=http://host.docker.internal:11434

# Frontend chat panel: explain (cited, local) or chat (syllabus triples, LLM_MODEL provider)
CHAT_MODE=explain
